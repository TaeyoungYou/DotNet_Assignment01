@model Assignment01.Models.Event
@using System.Security.Claims

@{
    ViewData["Title"]="Event Details";

    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isRegistered = Model.Attendees.Any(a => a.UserId == currentUserId);
}

<div class="container mt-4">
    <div class="mb-4 text-center">
        @if (!string.IsNullOrEmpty(Model.BannerUrl))
        {
            <img src="@Model.BannerUrl" class="img-fluid rounded shadow-sm banner-style" alt="banner" />
        }
        else
        {
            <div class="bg-light py-5 border rounded text-muted">No Event Banner</div>
        }
    </div>

    <div class="d-flex justify-content-between align-items-start mb-2">
        <div>
            <h1 class="display-5 font-weight-bold mb-0">@Model.Title</h1>
            <p class="text-muted mb-0">@Model.Location | @Model.Date.ToShortTimeString(), @Model.Date.ToLongDateString()</p>
        </div>
        
        <div class="d-flex gap-2" style="margin-top: 10px;">
            @if (User.IsInRole("Organizer"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit Event</a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
            }

            <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
        </div>
    </div>

    <hr class="mt-2 mb-4" />

    <div class="mb-5">
        <p class="desc-style">@Model.Description</p>
    </div>

    <div class="mt-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3>Attendees <span id="attendee-count" class="badge bg-black">@Model.Attendees.Count</span></h3>

            <div class="d-flex align-items-center gap-2">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    if (!isRegistered)
                    {
                        <form asp-action="Register" asp-route-eventId="@Model.Id" method="post">
                            <button type="submit" class="btn btn-success btn-sm">Register</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Unregister" asp-route-eventId="@Model.Id" method="post">
                            <button type="submit" class="btn btn-danger btn-sm">Unregister</button>
                        </form>
                    }
                }

                @if (User.IsInRole("Organizer"))
                {
                    <a asp-action="ManageAttendees" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">Manage Attendee</a>
                }
            </div>
        </div>

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <table class="table table-hover border">
                <thead class="thead-dark">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                    </tr>
                </thead>
                <tbody id="attendee-list">
                    @if (Model.Attendees != null && Model.Attendees.Any())
                    {
                        foreach (var attendee in Model.Attendees)
                        {
                            <tr>
                                <td>@attendee.Name</td>
                                <td>@attendee.Email</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr class="empty-attendee-row">
                            <td colspan="2" class="text-center text-muted">No attendee registered yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">
                Please log in to view the attendee list.
            </div>
        }
    </div>
</div>

<div class="toast-container position-fixed bottom-0 start-50 translate-middle-x p-3">
    <div id="organizerNotificationToast" class="toast text-bg-dark border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header text-bg-dark border-0">
            <strong class="me-auto">Organizer Notification</strong>
            <small>Now</small>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body" id="organizer-notification-message"></div>
    </div>
</div>


<input type="hidden" id="event-id" value="@Model.Id" />

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        const eventId = document.querySelector("#event-id").value;
        const attendeeCount = document.querySelector("#attendee-count");
        const attendeeList = document.querySelector("#attendee-list");

        if(eventId) {
            const eventGroupName = `event-${eventId}`;

            const connection = new signalR.HubConnectionBuilder()
                                .withUrl("/eventHub")
                                .build();

            connection.on("AttendeeRegistered", (count, attendeeName, attendeeEmail) => {
                if(attendeeCount) {
                    attendeeCount.textContent = count;
                }

                if(attendeeList) {
                    const emptyRow = attendeeList.querySelector(".empty-attendee-row");
                    if(emptyRow){
                        emptyRow.remove();
                    }

                    const row = document.createElement("tr");
                    row.innerHTML = `<td>${attendeeName}</td><td>${attendeeEmail}</td>`;
                    attendeeList.appendChild(row);
                }
            });

            connection.on("AttendeeUnregistered", (count, attendeeName, attendeeEmail) => {
                if (attendeeCount) {
                    attendeeCount.textContent = count;
                }

                if (attendeeList) {
                    const rows = attendeeList.querySelectorAll("tr");

                    rows.forEach(row => {
                        const nameCell = row.children[0];
                        const emailCell = row.children[1];

                        if (nameCell && emailCell &&
                            nameCell.textContent === attendeeName &&
                            emailCell.textContent === attendeeEmail) {
                            row.remove();
                        }
                    });

                    if (!attendeeList.querySelector("tr")) {
                        const emptyRow = document.createElement("tr");
                        emptyRow.className = "empty-attendee-row";
                        emptyRow.innerHTML = `<td colspan="2" class="text-center text-muted">No attendee registered yet.</td>`;
                        attendeeList.appendChild(emptyRow);
                    }
                }
            });

            connection.on("OrganizerNotification", (message) => {
                const toastElement = document.querySelector("#organizerNotificationToast");
                const toastMessage = document.querySelector("#organizer-notification-message");

                if(toastElement && toastMessage) {
                    toastMessage.textContent = message;

                    const toast = new bootstrap.Toast(toastElement, {delay: 4000});
                    toast.show();
                }
            });

            connection.start()
                .then(() => connection.invoke("JoinEventGroup", eventGroupName))
                .catch(err => console.log(err.toString()));
        }


    </script>
}
